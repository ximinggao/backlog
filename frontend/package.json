{
  "name": "es_react",
  "version": "1.0.0",
  "description": "Backlog Frontend",
  "scripts": {
    "build": "bun esbuild.mjs",
    "serve": "bunx serve public",
    "wasm": "cd rust-interface && wasm-pack build --target web && cp pkg/rust_interface_bg.wasm ../public/rust_interface_bg.wasm",
    "wasm-trace": "cd public && wasm2wat rust_interface_bg.wasm -o rust_interface_bg.wat"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "esbuild-css-modules-plugin": "^3.1.5"
  }
}
